    "from ydata_profiling import ProfileReport\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.read_csv(\"../data/raw/store_data.csv\")\n",
    "profile = ProfileReport(\n",
    "    df,\n",
    "    title=\"DataStore360 - Data Profiling\",\n",
    "    explorative=True\n",
    ")\n",
    "profile.to_file(\"../raports/rapport_profiling.html\")"
   ]
